{
  "ConnectionStrings": {
    "DatabaseType": "0",
  },
  "Jwt": {
    "Issuer": "KronPay.Api",
    "Audience": "KronPay.Front"
  },
  "Database": {
    "AutoMigrate": false,
    "Provider": "Postgres"
    //"Provider": "SqlServer"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:8080", "https://kronpay-app.vitorlirasti.workers.dev"]
  },
  "DataRetention": {
    "PurgeAfterDays": 30
  },
  "AI": {
    "Enabled": false,
    "Provider": "OpenAI",
    "Chat": {
      "MaxMessagesPerDay": 100,
      "MaxToolIterations": 6,
      "MaxHistoryMessages": 10,
      "MaxOutputTokens": 1200
    },
    "Providers": {
      "OpenAI": {
        "BaseUrl": "https://api.openai.com/v1",
        "Model": "gpt-6-luna",
        "TimeoutSeconds": 120,
        "SupportsFiles": true,
        "ToolReasoningEffort": "none",
        "StructuredChatOutput": true,
        "InputPricePerMillion": 0.10,
        "CachedInputPricePerMillion": 0.01,
        "OutputPricePerMillion": 0.50
      },
      "Groq": {
        "BaseUrl": "https://api.groq.com/openai/v1",
        "Model": "llama-3.1-8b-instant",
        "TimeoutSeconds": 60,
        "SupportsFiles": false,
        "InputPricePerMillion": 0.05,
        "CachedInputPricePerMillion": 0.05,
        "OutputPricePerMillion": 0.08
      },
      "Ollama": {
        "BaseUrl": "http://localhost:11434/v1",
        "Model": "phi3",
        "TimeoutSeconds": 300,
        "SupportsFiles": false,
        "InputPricePerMillion": 0,
        "CachedInputPricePerMillion": 0,
        "OutputPricePerMillion": 0
      }
    }
  },

  "Assistant": {
    "EmbeddingModelPath": "Assets/Models/paraphrase-multilingual-MiniLM-L12-v2.onnx",
    "TokenizerModelPath": "Assets/Models/sentencepiece.bpe.model",
    "SimilarityThreshold": 0.75,
    "FuzzySimilarityThreshold": 0.8,
    "FuzzyMinimumMargin": 0.1,
    "TopicMinimumMargin": 0.025
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "KronPay",
    "SenderEmail": "",
    "Username": "",
    "Password": ""
    // Username/Password (senha de app do Gmail) NÃO devem ser versionados aqui —
    // configurar via User Secrets ou variável de ambiente (ver rules/inconsistencies.md #8)
  }

}
