{
  "ConnectionStrings": {
    "DatabaseType": "0",
  },
  "Jwt": {
    "Issuer": "KronPay.Api",
    "Audience": "KronPay.Front"
  },
  "Database": {
    "AutoMigrate": true,
    "Provider": "Postgres"
    //"Provider": "SqlServer"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:8080"]
  },
  "DataRetention": {
    "PurgeAfterDays": 30
  },
  "OpenAI": {
    "Model": "gpt-4o-mini"
  },
  "AI": {
    "Provider": "Groq"
    // OpenAI | Ollama | Fallback | Groq
  },

  "Groq": {
    "Model": "llama-3.1-8b-instant"
  },

  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "phi3"
  },

  "Assistant": {
    "EmbeddingModelPath": "Assets/Models/paraphrase-multilingual-MiniLM-L12-v2.onnx",
    "TokenizerModelPath": "Assets/Models/sentencepiece.bpe.model",
    "SimilarityThreshold": 0.75,
    "FuzzySimilarityThreshold": 0.8,
    "FuzzyMinimumMargin": 0.1,
    "TopicMinimumMargin": 0.025
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "KronPay",
    "SenderEmail": "",
    "Username": "",
    "Password": ""
    // Username/Password (senha de app do Gmail) NÃO devem ser versionados aqui —
    // configurar via User Secrets ou variável de ambiente (ver rules/inconsistencies.md #8)
  }

}
